# Copy to .env and fill locally. Never commit real values.
# F0 does not read these; they exist so later phases do not invent ad-hoc secrets.

# Optional hub token for *future* documented integrations. F0 must not use it.
HF_TOKEN=

# Local cache root if a later phase fetches third-party weights the user already licensed.
# F0 does not download or bundle models.
MODEL_CACHE_ROOT=
